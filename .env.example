# Copy to .env and adjust as needed. Python reads exported environment
# variables, not this file. In bash/zsh: set -a; source .env; set +a

# Synthesis backend: auto | anthropic | local | stub.
# auto tries Anthropic first when ANTHROPIC_API_KEY is set, then local Ollama,
# then stub. Use "local" to ignore Anthropic even when the key exists.
ARGUS_SYNTHESIS_BACKEND=auto

# Optional: enables cloud LLM synthesis when ARGUS_SYNTHESIS_BACKEND is auto or
# anthropic. Without it -- or if the call fails in auto mode -- the pipeline
# falls back to the local Ollama model below, then to stub reports (clustered
# stories, no synthesized prose) as the final fallback. Local/stub synthesis
# makes no paid model API calls; local compute and network are still required.
# ANTHROPIC_API_KEY=sk-ant-...

# Local LLM via Ollama (https://ollama.com). Requires Ollama running and the
# model pulled: `ollama pull qwen3:14b`. This is THE local model -- local
# routing is single-tier, so rank does not select a different one. To skip the
# local path entirely set ARGUS_SYNTHESIS_BACKEND=anthropic (or =stub); leaving
# this blank falls back to the default rather than disabling anything.
ARGUS_LOCAL_LLM_MODEL=qwen3:14b
ARGUS_LOCAL_LLM_HOST=http://localhost:11434
# Local CPU inference is slow -- this runs as an overnight batch job, so a
# long per-story timeout is fine. Lower this if you want faster failure.
ARGUS_LOCAL_LLM_TIMEOUT_SECONDS=180

# Daily schedule (used by the argus.scheduler module)
ARGUS_SCHEDULE_HOUR=6
ARGUS_SCHEDULE_MINUTE=0

# Paths (defaults shown; rarely need to change these). Relative paths resolve
# against the repo root, not the current directory; absolute paths are used as-is.
ARGUS_DATA_DIR=data
ARGUS_REPORTS_DIR=reports
ARGUS_SOURCES_FILE=config/sources.yaml

# Pipeline tuning
ARGUS_MAX_STORIES=15
ARGUS_CLUSTER_WINDOW_HOURS=48
